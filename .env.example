# Copy to .env and fill in. docker compose picks up .env automatically.

# ---- Technitium (runs in this compose stack) ----
# Admin password for the dns-server container. Defaults to the value baked
# into docker-compose.yml if unset.
DNS_SERVER_ADMIN_PASSWORD=

# netdb -> Technitium auth. Use EITHER the token OR the user+password pair:
#   - Token: create one from Technitium admin UI (Administration > Sessions)
#   - user+password: netdb auto-bootstraps a permanent token on first use
#     and caches it in memory. Password must match DNS_SERVER_ADMIN_PASSWORD.
NETDB_TECHNITIUM_TOKEN=
NETDB_TECHNITIUM_USER=admin
NETDB_TECHNITIUM_PASSWORD=
# Set to 'true' if you point NETDB_TECHNITIUM_URL at the HTTPS admin port
# with its self-signed cert (port 53443).
NETDB_TECHNITIUM_INSECURE=

# ---- Cloudflare ----
# API token scoped to Zone:DNS:Edit on each zone you want netdb to manage.
# The zone(s) must already exist in your Cloudflare account — netdb doesn't
# create zones on CF's side.
NETDB_CLOUDFLARE_TOKEN=

# ---- Reconciler ----
# How often to push records to providers. Accepts any Go duration string.
# Sync-now button on /dns triggers an out-of-schedule run.
NETDB_RECONCILE_INTERVAL=60s

# ---- Kea (DHCP) ----
# ctrl-agent URL. Defaults to the compose service name + port. Empty disables
# Kea sync entirely (useful if you don't run the DHCP half of the stack).
NETDB_KEA_URL=http://kea-ctrl-agent:8000/
NETDB_KEA_SYNC_INTERVAL=60s
# How often netdb polls Kea for active leases (creates auto-discovered hosts).
NETDB_KEA_LEASE_POLL_INTERVAL=30s

# ---- Basic auth ----
# Gate the WebUI. Both empty → auth disabled (use only on a trusted LAN).
# /healthz and /static/* are always open so monitoring keeps working.
NETDB_USER=
NETDB_PASSWORD=
